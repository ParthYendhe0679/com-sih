# ====================================================
#              KRITAGAS ENVIRONMENT CONFIGURATION
# ====================================================
# Copy this file to .env and configure values for your deployment.
# NEVER commit your real .env file or real API keys to version control.

# Application Configuration
APP_NAME="KRITAGAS Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Security & Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL with asyncpg driver)
# Mode 1: Local Docker / PostgreSQL
DATABASE_URL="postgresql+asyncpg://postgres:postgres_secure_password@localhost:5432/kritagas_db"

# Mode 2: Cloud Neon PostgreSQL (example format - replace with your secret credentials in .env)
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Database Connection Pool Tuning
DATABASE_ECHO=false
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800

# Docker PostgreSQL Environment (if using local compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="kritagas_db"
POSTGRES_PORT=5432

# CORS Settings (Comma separated origins or frontend URL)
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Storage Settings
STORAGE_BACKEND="local"
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./uploads"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# ====================================================
#              AI PROVIDER CONFIGURATION
# ====================================================

# Groq Cloud Provider (Fast Llama-3 Reasoning & Entity Analysis)
# Configure your active key index (1, 2, 3, or 4)
GROQ_PRIMARY_KEY_INDEX=1
GROQ_API_KEY_1=""
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""
GROQ_API_KEY_4=""
GROQ_MODEL="llama-3.3-70b-versatile"
# GROQ_API_KEY="" # Legacy backward compatibility alias

# Google Gemini Provider (Multimodal, Summaries & Intelligence Reports)
# Configure your active key index (1 or 2)
GEMINI_PRIMARY_KEY_INDEX=1
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_MODEL="gemini-1.5-flash"
# GEMINI_API_KEY="" # Legacy backward compatibility alias

# Hugging Face Provider (Embeddings, Sentence Transformers & Cross-Encoders)
HUGGINGFACE_API_KEY=""
HF_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# OpenAI Provider (Optional/Future)
OPENAI_API_KEY=""

# AI Router & Orchestration Pipeline
AI_DEFAULT_PROVIDER="groq"
AI_ENABLE_GROQ=true
AI_ENABLE_GEMINI=true
AI_ENABLE_HUGGINGFACE=true
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=2

# ML & Similarity Thresholds
EMBEDDING_MODEL="all-MiniLM-L6-v2"
SIMILARITY_THRESHOLD=0.75
ENTITY_MATCH_THRESHOLD=0.80

# ====================================================
#              INFRASTRUCTURE (OPTIONAL)
# ====================================================
REDIS_URL=""
NEO4J_URI=""
NEO4J_USERNAME=""
NEO4J_PASSWORD=""

# Valkey Cache Configuration (Aiven Valkey / Redis-compatible)
ENABLE_VALKEY=true
VALKEY_URL="rediss://default:YOUR_VALKEY_PASSWORD@your-valkey-host.aivencloud.com:24408"
VALKEY_HOST=""
VALKEY_PORT=24408
VALKEY_USERNAME="default"
VALKEY_PASSWORD=""
VALKEY_SSL=true
VALKEY_SOCKET_TIMEOUT=3.0
VALKEY_CONNECT_TIMEOUT=5.0

# Feature Flags
ENABLE_AI=true
ENABLE_GRAPH=false
ENABLE_REDIS=false
ENABLE_BLOCKCHAIN=false
ENABLE_OCR=false

# Blockchain Evidence Integrity Configuration
BLOCKCHAIN_MODE="mock"              # mock | ethereum
BLOCKCHAIN_PROVIDER="mock"
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=""
BLOCKCHAIN_PRIVATE_KEY=""
BLOCKCHAIN_CONTRACT_ADDRESS=""

